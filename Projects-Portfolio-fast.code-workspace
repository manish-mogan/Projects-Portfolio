{
  "folders": [
    {
      "name": "Projects-Portfolio",
      "path": "."
    }
  ],
  "settings": {
    "files.watcherExclude": {
      "**/.git/**": true,
      "**/.venv/**": true,
      ".venv/**": true,
      "**/__pycache__/**": true,
      "**/.ipynb_checkpoints/**": true,
      "data/**": true
    },
    "search.exclude": {
      "**/.git/**": true,
      "**/.venv/**": true,
      ".venv/**": true,
      "**/__pycache__/**": true,
      "**/.ipynb_checkpoints/**": true,
      "data/**": true
    },
    "files.exclude": {
      "**/.git/**": true,
      "**/.venv/**": true,
      ".venv/**": true,
      "**/__pycache__/**": true,
      "**/.ipynb_checkpoints/**": true,
      "data/**": true
    },

    "python.analysis.exclude": [
      "**/.git/**",
      "**/.venv/**",
      ".venv/**",
      "**/__pycache__/**",
      "**/.ipynb_checkpoints/**",
      "data/**"
    ],
    "python.analysis.indexing": false,
    "python.analysis.diagnosticMode": "openFilesOnly",

    "git.autorefresh": true
  }
}
