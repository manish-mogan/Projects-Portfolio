{
  "folders": [
    {
      "name": "Projects-Portfolio",
      "path": "."
    }
  ],
  "settings": {
    "files.watcherExclude": {
      "**/.git/**": true,
      "**/.venv/**": true,
      ".venv/**": true,
      "**/__pycache__/**": true,
      "**/.ipynb_checkpoints/**": true,
      "data/**": true
    },
    "search.exclude": {
      "**/.git/**": true,
      "**/.venv/**": true,
      ".venv/**": true,
      "**/__pycache__/**": true,
      "**/.ipynb_checkpoints/**": true,
      "data/**": true
    },
    "files.exclude": {
      "**/.git/**": true,
      "**/.venv/**": true,
      ".venv/**": true,
      "**/__pycache__/**": true,
      "**/.ipynb_checkpoints/**": true,
      "data/**": true,
      ".gitignore": true,
      "README.md": true,
      "requirements.txt": true,
      "pyrightconfig.json": true,
      "*.code-workspace": true
    },
    "python.analysis.indexing": false,
    "python.analysis.diagnosticMode": "openFilesOnly",

    "git.autorefresh": true
  }
}
